,785],{"class":105},")",[91,787,751],{"class":105},[91,789,791,794,796,798,800,803,806,808,810,812,814],{"class":93,"line":790},28,[91,792,793],{"class":105},"                $",[91,795,725],{"class":101},[91,797,197],{"class":105},[91,799,586],{"class":200},[91,801,802],{"class":105},"()->",[91,804,805],{"class":200},"detach",[91,807,495],{"class":105},[91,809,734],{"class":101},[91,811,197],{"class":105},[91,813,768],{"class":200},[91,815,816],{"class":105},"());\n",[91,818,820],{"class":93,"line":819},29,[91,821,822],{"class":105},"            }\n",[91,824,826],{"class":93,"line":825},30,[91,827,191],{"emptyLinePlaceholder":190},[91,829,831,833,835,837,839,841,843,845,847,849,851,853],{"class":93,"line":830},31,[91,832,758],{"class":757},[91,834,761],{"class":105},[91,836,743],{"class":101},[91,838,197],{"class":105},[91,840,768],{"class":200},[91,842,771],{"class":105},[91,844,774],{"class":105},[91,846,777],{"class":210},[91,848,214],{"class":105},[91,850,782],{"class":101},[91,852,785],{"class":105},[91,854,751],{"class":105},[91,856,858,860,862,864,866,868,871,874,876,878,880],{"class":93,"line":857},32,[91,859,793],{"class":105},[91,861,725],{"class":101},[91,863,197],{"class":105},[91,865,586],{"class":200},[91,867,802],{"class":105},[91,869,870],{"class":200},"syncWithoutDetaching",[91,872,873],{"class":105},"([$",[91,875,743],{"class":101},[91,877,197],{"class":105},[91,879,768],{"class":200},[91,881,882],{"class":105},"()]);\n",[91,884,886],{"class":93,"line":885},33,[91,887,822],{"class":105},[91,889,891],{"class":93,"line":890},34,[91,892,893],{"class":105},"        }),\n",[91,895,897],{"class":93,"line":896},35,[91,898,899],{"class":105},"])\n",[901,902,903,904,907,908,910],"p",{},"Defining groupings adds a \"Group by\" select to the board. It sits above the board under the filters. With ",[88,905,906],{},"headerToolbar()"," it moves into the page header, next to the filters and search. A standalone board has no page header, so with ",[88,909,906],{}," it shows no picker, the same as its filters.",[901,912,913,914,917],{},"The choice lives in the URL as ",[88,915,916],{},"?groupBy=assignee",", so a grouped view can be shared. Choosing \"None\" returns to the plain board.",[76,919,920],{"id":287},"Lanes",[922,923,924,935,960,973,989,992,995,1006],"ul",{},[925,926,927,930,931,934],"li",{},[88,928,929],{},"lanes()"," receives the board query with filters and search applied. Name the parameter ",[88,932,933],{},"$boardQuery",", or type it as the Eloquent builder. Return the lanes in the order to show them.",[925,936,937,938,940,941,944,945,948,949,948,952,955,956,959],{},"A ",[88,939,182],{}," takes a name, which must be unique within the grouping, and a ",[88,942,943],{},"query()"," closure that narrows the board query to that lane. It also takes ",[88,946,947],{},"label()",", ",[88,950,951],{},"avatar()",[88,953,954],{},"color()"," and ",[88,957,958],{},"icon()",".",[925,961,962,965,966,969,970,959],{},[88,963,964],{},"emptyLane()"," adds a last lane for cards that match none of the others. The name ",[88,967,968],{},"Grouping::EMPTY_LANE"," identifies it in ",[88,971,972],{},"moveUsing()",[925,974,975,978,979,982,983,955,986,959],{},[88,976,977],{},"Grouping::attribute('priority')"," builds one lane per distinct value, busiest first, plus an empty lane for ",[88,980,981],{},"null",". A backed enum cast supplies the labels and colors when it implements Filament's ",[88,984,985],{},"HasLabel",[88,987,988],{},"HasColor",[925,990,991],{},"A card that matches two lanes appears in both. The move callback receives the lane the card left, so only that link changes.",[925,993,994],{},"A lane with no cards in view is not shown.",[925,996,997,998,1001,1002,1005],{},"Ten lanes render at first, and \"Show more lanes\" loads ten more. Change the page size with ",[88,999,1000],{},"->lanesPerPage()",". Each cell shows ",[88,1003,1004],{},"cardsPerColumn()"," cards, then \"Show N more\".",[925,1007,1008],{},"Each rendered lane loads its cards in one query, using window functions.",[901,1010,1011,1012,948,1015,955,1018,1021,1022,1025,1026,1029,1030,959],{},"The paging state (",[88,1013,1014],{},"$visibleLaneCount",[88,1016,1017],{},"$cellCardLimits",[88,1019,1020],{},"$columnCardLimits",") is ",[88,1023,1024],{},"#[Locked]",", so the browser cannot write it. ",[88,1027,1028],{},"loadMoreItems()"," clamps the count it loads into a lane cell to between 1 and ",[88,1031,1004],{},[76,1033,1035],{"id":1034},"creating-cards-in-lane-mode","Creating cards in lane mode",[901,1037,1038,1039,1042,1043,1046,1047,1049,1050,1052],{},"The header ",[88,1040,1041],{},"+"," from ",[88,1044,1045],{},"createCardAction()"," creates a card without knowing the lane. The card lands in whichever lane its data matches. A custom grouping without ",[88,1048,964],{}," hides a card that matches no lane, so add ",[88,1051,964],{}," to every custom grouping. Lane cells have no add row.",[76,1054,1056],{"id":1055},"moving-between-lanes","Moving between lanes",[922,1058,1059,1069,1087,1100,1106],{},[925,1060,1061,1062,1064,1065,1068],{},"With ",[88,1063,972],{},", a drop into another lane runs the callback in the same transaction as the column move. Throw ",[88,1066,1067],{},"CardMoveRejectedException::because('...')"," to refuse. Both writes roll back, the user sees the message, and the card returns.",[925,1070,1071,1072,1075,1076,1079,1080,1083,1084,959],{},"The callback receives the card as ",[88,1073,1074],{},"$card"," or ",[88,1077,1078],{},"$record",", or typed by its model class, plus the lane it left as ",[88,1081,1082],{},"$from"," and the lane it entered as ",[88,1085,1086],{},"$to",[925,1088,1089,1092,1093,1095,1096,1099],{},[88,1090,1091],{},"Grouping::attribute()"," writes the attribute itself, and writes ",[88,1094,981],{}," for the empty lane. An attribute qualified with another table's name, such as ",[88,1097,1098],{},"'details.priority'",", is read-only.",[925,1101,1102,1103,1105],{},"Without ",[88,1104,972],{},", the lanes are read-only. Cards move between columns inside their lane, the browser blocks a drop into another lane, and the server refuses it with a message.",[925,1107,1108],{},"The server checks that the card sits in the lane it left, and refuses the move when the board has changed underneath the user.",[76,1110,1112],{"id":1111},"limits-and-collapsed-columns","Limits and collapsed columns",[922,1114,1115,1118],{},[925,1116,1117],{},"A column limit counts the whole column across every lane, and the header is shared.",[925,1119,1120,1123],{},[88,1121,1122],{},"collapseEmptyColumns()"," applies to the plain board only. In lanes every column keeps its width, so every cell stays a drop target.",[1125,1126,1127],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoratio