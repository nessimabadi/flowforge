\u002Flicense","4.community\u002F2.license","i-lucide-scale",{"id":71,"title":16,"body":72,"description":2146,"extension":2147,"links":2148,"meta":2149,"navigation":2150,"path":17,"seo":2151,"stem":18,"__hash__":2152},"docs\u002F1.getting-started\u002F2.upgrading.md",{"type":73,"value":74,"toc":2117},"minimark",[75,80,84,89,111,115,139,143,148,159,166,301,312,341,345,350,354,361,435,446,465,469,476,480,540,544,547,827,843,847,858,861,865,870,873,884,888,906,917,921,932,934,938,942,945,967,971,975,987,992,1144,1147,1162,1168,1172,1176,1201,1205,1208,1318,1321,1331,1333,1337,1340,1343,1356,1359,1362,1373,1377,1509,1511,1523,1527,1827,1829,1847,1850,1853,1856,1900,1904,1908,1911,1940,1943,1953,1955,1959,1965,1968,2110,2113],[76,77,79],"h2",{"id":78},"from-v4x-to-v5x","From v4.x to v5.x",[81,82,83],"p",{},"v5 redesigns the board and adds column summaries, hard column limits, card components and swimlanes. It needs no migration, no config key and no env var.",[85,86,88],"h3",{"id":87},"requirements","Requirements",[90,91,92,96,99],"ul",{},[93,94,95],"li",{},"Filament 5 and PHP 8.3, as in v4.",[93,97,98],{},"Groupings use window functions: MySQL 8, MariaDB 10.2, PostgreSQL, SQLite 3.25 or SQL Server. Boards without groupings have no new requirement.",[93,100,101,102,106,107,110],{},"Hard limits take a cache lock, so use a store that every server shares, such as redis, memcached, database or dynamodb. The ",[103,104,105],"code",{},"array"," store locks per process and the ",[103,108,109],{},"null"," store never blocks. Under either, two simultaneous drops can both pass a limit.",[85,112,114],{"id":113},"upgrade-steps","Upgrade steps",[116,117,118,123,129,136],"ol",{},[93,119,120],{},[103,121,122],{},"composer require relaticle\u002Fflowforge:^5.0",[93,124,125,128],{},[103,126,127],{},"php artisan filament:assets",", which publishes the new stylesheet.",[93,130,131,132,135],{},"Standalone boards (outside a Filament panel) need ",[103,133,134],{},"@filamentStyles"," in their layout.",[93,137,138],{},"If you published Flowforge views or lang files, republish them and merge your changes.",[85,140,142],{"id":141},"high-impact-changes","High impact changes",[144,145,147],"h4",{"id":146},"the-board-looks-different","The board looks different",[81,149,150,151,154,155,158],{},"Columns are borderless trays with the header above them. The count is plain text instead of a badge, and ",[103,152,153],{},"Column::color()"," draws a dot before the label. An empty column shows no placeholder text, only its add row. Restyle through the ",[103,156,157],{},"--ff-*"," custom properties (see Design Tokens under Customization), not by copying views.",[144,160,162,165],{"id":161},"movecard-signature-and-return-type",[103,163,164],{},"moveCard()"," signature and return type",[167,168,173],"pre",{"className":169,"code":170,"language":171,"meta":172,"style":172},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","public function moveCard(\n    string $cardId,\n    string $targetColumnId,\n    ?string $afterCardId = null,\n    ?string $beforeCardId = null,\n    ?string $fromLaneId = null,\n    ?string $toLaneId = null,\n): bool\n","php","",[103,174,175,195,212,224,244,260,276,292],{"__ignoreMap":172},[176,177,180,184,187,191],"span",{"class":178,"line":179},"line",1,[176,181,183],{"class":182},"spNyl","public",[176,185,186],{"class":182}," function",[176,188,190],{"class":189},"s2Zo4"," moveCard",[176,192,194],{"class":193},"sMK4o","(\n",[176,196,198,202,205,209],{"class":178,"line":197},2,[176,199,201],{"class":200},"sbssI","    string",[176,203,204],{"class":193}," $",[176,206,208],{"class":207},"sTEyZ","cardId",[176,210,211],{"class":193},",\n",[176,213,215,217,219,222],{"class":178,"line":214},3,[176,216,201],{"class":200},[176,218,204],{"class":193},[176,220,221],{"class":207},"targetColumnId",[176,223,211],{"class":193},[176,225,227,230,233,235,238,241],{"class":178,"line":226},4,[176,228,229],{"class":193},"    ?",[176,231,232],{"class":200},"string",[176,234,204],{"class":193},[176,236,237],{"class":207},"afterCardId ",[176,239,240],{"class":193},"=",[176,242,243],{"class":193}," null,\n",[176,245,247,249,251,253,256,258],{"class":178,"line":246},5,[176,248,229],{"class":193},[176,250,232],{"class":200},[176,252,204],{"class":193},[176,254,255],{"class":207},"beforeCardId ",[176,257,240],{"class":193},[176,259,243],{"class":193},[176,261,263,265,267,269,272,274],{"class":178,"line":262},6,[176,264,229],{"class":193},[176,266,232],{"class":200},[176,268,204],{"class":193},[176,270,271],{"class":207},"fromLaneId ",[176,273,240],{"class":193},[176,275,243],{"class":193},[176,277,279,281,283,285,288,290],{"class":178,"line":278},7,[176,280,229],{"class":193},[176,282,232],{"class":200},[176,284,204],{"class":193},[176,286,287],{"class":207},"toLaneId ",[176,289,240],{"class":193},[176,291,243],{"class":193},[176,293,295,298],{"class":178,"line":294},8,[176,296,297],{"class":193},"):",[176,299,300],{"class":200}," bool\n",[81,302,303,304,307,308,311],{},"v4 returned ",[103,305,306],{},"void",". An override that keeps ",[103,309,310],{},": void"," or the four-argument signature is now a fatal error.",[81,313,314,316,317,320,321,324,325,328,329,332,333,336,337,340],{},[103,315,164],{}," returns ",[103,318,319],{},"false"," when it refuses a move, and the browser puts the card back. Most overrides can go. Put checks in ",[103,322,323],{},"authorizeCardMove(Model $card, string $targetColumnId, ?string $toLaneId = null): void"," and custom writes in ",[103,326,327],{},"persistCardMove(Model $card, mixed $columnValue, string $position): void",". Throw ",[103,330,331],{},"CardMoveRejectedException::because('...')"," from ",[103,334,335],{},"authorizeCardMove()"," to refuse with a message. An ",[103,338,339],{},"abort(403)"," there still reverts the card, but Livewire shows its error UI instead of a toast.",[144,342,344],{"id":343},"moves-to-unknown-columns-and-cards-are-refused","Moves to unknown columns and cards are refused",[81,346,347,349],{},[103,348,164],{}," refuses a target column the board does not show, and a card its query no longer returns. The user sees a notification and the card returns. v4 wrote any value the browser sent.",[85,351,353],{"id":352},"medium-impact-changes","Medium impact changes",[144,355,357,358],{"id":356},"the-add-row-needs-createcardaction","The add row needs ",[103,359,360],{},"createCardAction()",[167,362,364],{"className":169,"code":363,"language":171,"meta":172,"style":172},"$board->createCardAction(\n    CreateAction::make('createTask')->model(Task::class)->schema([...]),\n);\n",[103,365,366,382,430],{"__ignoreMap":172},[176,367,368,371,374,377,380],{"class":178,"line":179},[176,369,370],{"class":193},"$",[176,372,373],{"class":207},"board",[176,375,376],{"class":193},"->",[176,378,379],{"class":189},"createCardAction",[176,381,194],{"class":193},[176,383,384,388,391,394,397,400,404,406,409,412,414,417,419,422,424,427],{"class":178,"line":197},[176,385,387],{"class":386},"sBMFI","    CreateAction",[176,389,390],{"class":193},"::",[176,392,393],{"class":189},"make",[176,395,396],{"class":193},"(",[176,398,399],{"class":193},"'",[176,401,403],{"class":402},"sfazB","createTask",[176,405,399],{"class":193},[176,407,408],{"class":193},")->",[176,410,411],{"class":189},"model",[176,413,396],{"class":193},[176,415,416],{"class":386},"Task",[176,418,390],{"class":193},[176,420,421],{"class":200},"class",[176,423,408],{"class":193},[176,425,426],{"class":189},"schema",[176,428,429],{"class":193},"([...]),\n",[176,431,432],{"class":178,"line":214},[176,433,434],{"class":193},");\n",[81,436,437,438,441,442,445],{},"Flowforge renders it as a ",[103,439,440],{},"+"," in each header and as an add row under the cards, and passes the column as ",[103,443,444],{},"$arguments['column']",". It hides both when the action is not visible.",[81,447,448,449,452,453,456,457,460,461,464],{},"Flowforge owns the action's ",[103,450,451],{},"disabled()"," state. It disables the action for unknown and full columns, and, with ",[103,454,455],{},"authorizationTooltip()",", when the action's authorization fails. Block creation for your own reasons with ",[103,458,459],{},"authorize()"," or ",[103,462,463],{},"visible()",".",[144,466,468],{"id":467},"dragging-uses-sortablejs-fallback-mode","Dragging uses SortableJS fallback mode",[81,470,471,472,475],{},"The dragged card is a real element, so it can lift and tilt, and touch works. CSS that targeted native drag states, or code listening for ",[103,473,474],{},"dragenter"," on the board, stops working.",[144,477,479],{"id":478},"published-views-and-column-paging-state","Published views and column paging state",[90,481,482,504,510,531],{},[93,483,484,485,488,489,492,493,496,497,492,500,503],{},"The ",[103,486,487],{},"flowforge::column-count"," component takes ",[103,490,491],{},"column"," and ",[103,494,495],{},"columnId"," instead of ",[103,498,499],{},"color",[103,501,502],{},"total",". A published copy of a v4 view that renders it breaks.",[93,505,484,506,509],{},[103,507,508],{},"flowforge::empty-column"," component is removed.",[93,511,512,515,516,519,520,523,524,460,527,530],{},[103,513,514],{},"$columnCardLimits"," is now ",[103,517,518],{},"#[Locked]",", as are the new lane paging properties. JavaScript or a view that writes them from the browser gets a ",[103,521,522],{},"CannotUpdateLockedPropertyException",". Call ",[103,525,526],{},"loadMoreItems()",[103,528,529],{},"loadAllItems()"," instead.",[93,532,533,535,536,539],{},[103,534,526],{}," clamps the count it loads into a lane cell to between 1 and ",[103,537,538],{},"cardsPerColumn()",". The flat board still loads up to the count you pass, capped at the column total. A count below 1 now loads one card: v4 had no lower bound, so 0 loaded nothing and a negative count shrank the column.",[144,541,543],{"id":542},"position-helpers-gained-a-lane-parameter","Position helpers gained a lane parameter",[81,545,546],{},"Moves across lanes pass a lane move through three protected methods. A subclass that overrides one with the v4 signature hits a PHP fatal error, because the override no longer accepts every parameter. These are the current signatures:",[167,548,550],{"className":169,"code":549,"language":171,"meta":172,"style":172},"protected function moveCardWithinLimit(\n    Model $card,\n    string $targetColumnId,\n    ?string $afterCardId,\n    ?string $beforeCardId,\n    ?array $laneMove = null,\n): string\n\nprotected function calculateAndUpdatePosition(\n    Model $card,\n    string $targetColumnId,\n    ?string $afterCardId,\n    ?string $beforeCardId,\n    ?array $laneMove = null,\n): string\n\nprotected function calculateAndUpdatePositionWithRetry(\n    Model $card,\n    string $targetColumnId,\n    ?string $afterCardId,\n    ?string $beforeCardId,\n    int $maxAttempts = 3,\n    ?array $laneMove = null,\n): string\n",[103,551,552,564,576,586,599,612,627,634,640,652,663,674,687,700,715,722,727,739,750,761,774,787,805,820],{"__ignoreMap":172},[176,553,554,557,559,562],{"class":178,"line":179},[176,555,556],{"class":182},"protected",[176,558,186],{"class":182},[176,560,561],{"class":189}," moveCardWithinLimit",[176,563,194],{"class":193},[176,565,566,569,571,574],{"class":178,"line":197},[176,567,568],{"class":386},"    Model",[176,570,204],{"class":193},[176,572,573],{"class":207},"card",[176,575,211],{"class":193},[176,577,578,580,582,584],{"class":178,"line":214},[176,579,201],{"class":200},[176,581,204],{"class":193},[176,583,221],{"class":207},[176,585,211],{"class":193},[176,587,588,590,592,594,597],{"class":178,"line":226},[176,589,229],{"class":193},[176,591,232],{"class":200},[176,593,204],{"class":193},[176,595,596],{"class":207},"afterCardId",[176,598,211],{"class":193},[176,600,601,603,605,607,610],{"class":178,"line":246},[176,602,229],{"class":193},[176,604,232],{"class":200},[176,606,204],{"class":193},[176,608,609],{"class":207},"b